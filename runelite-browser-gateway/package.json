{
	"name": "runelite-browser-gateway",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Blind WSS<->TCP relay so the browser client can reach the OSRS game/JS5 servers (which are raw TCP on :43594).",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"format": "oxfmt src test",
		"format:check": "oxfmt --check src test",
		"build": "node build.mjs",
		"start": "node dist/serve.js",
		"test": "vitest run"
	},
	"dependencies": {
		"ws": "^8.21.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/ws": "^8.18.1",
		"esbuild": "^0.28.1",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
